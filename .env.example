# Copy to .env and fill in. Never commit .env.

# AI explanations, triage text and the customer assistant
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Which event log everyone reads. Swap to data/generated/events.csv once the
# generator is running.
AGENTLENS_EVENTS=data/sample/events.csv
AGENTLENS_AGENTS=data/sample/agents.csv
AGENTLENS_CONFIG=audit/config.yaml

# Set to 1 to stop any call to the LLM (use canned explanations for filming)
AGENTLENS_OFFLINE=0

# SQLite file for the mock loan pipeline. Default: agents/agentlens.db
# Use an absolute path if you override it.
# AGENTLENS_DB=
