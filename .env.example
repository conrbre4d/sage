# Copy to .env and fill in. Never commit .env.

# LLM: QUT's Azure OpenAI gateway (used by agents/llm.py)
API_KEY=
LLM_MODEL=gpt-4.1-mini
AZURE_OPENAI_ENDPOINT=https://qut-ai.azure-api.net/ifb220
AZURE_OPENAI_API_VERSION=2025-03-01-preview

# Storage: "supabase" (the real one) or "local" (SQLite file, no internet needed)
AGENTLENS_BACKEND=supabase

# Supabase: Project Settings -> Data API (URL) and API Keys (secret key).
# The secret key bypasses Row Level Security: server-side only, never in a browser.
# (A legacy "service_role" key also works here.)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=

# Encrypts identity + documents before they're stored. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Everyone processing the same Supabase data needs the SAME key. Lose it = data unreadable.
AGENTLENS_ENCRYPTION_KEY=

# 1 = never call the LLM (uses cached answers, else plain-Python fallback). Use while filming.
AGENTLENS_OFFLINE=0

# Local mode only: SQLite file. Default: agents/agentlens.db (use an absolute path if you override it)
# AGENTLENS_DB=

# Round 1 sample data (shared/validate.py)
AGENTLENS_EVENTS=data/sample/events.csv
AGENTLENS_AGENTS=data/sample/agents.csv
AGENTLENS_CONFIG=audit/config.yaml
